# Groww API Configuration (Indian Equities & F&O)
GROWW_API_KEY=
GROWW_TOTP_SECRET=

# Alpaca Paper Trading API Configuration (US Equities & ETFs)
# Sign up at https://alpaca.markets/ to get free paper API keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_TRADE=true

# SEC EDGAR User-Agent (for trader-news 8-Ks & trader-analyst)
SEC_USER_AGENT=Trader trader@example.com

# Flask Server Configuration
FLASK_SECRET_KEY=groww-trading-secret-key-change-in-prod
FLASK_PORT=5000
FLASK_DEBUG=True
